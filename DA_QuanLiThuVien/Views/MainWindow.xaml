<Window x:Class="DA_QuanLiThuVien.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DA_QuanLiThuVien.Views"
        xmlns:vm="clr-namespace:DA_QuanLiThuVien.ViewModels.Main"
        xmlns:vmReader="clr-namespace:DA_QuanLiThuVien.ViewModels.Main.Reader"
        xmlns:vmLibrarian="clr-namespace:DA_QuanLiThuVien.ViewModels.Main.Librarian"
        xmlns:viewLibrarian="clr-namespace:DA_QuanLiThuVien.Views.Librarian"
        xmlns:viewReader="clr-namespace:DA_QuanLiThuVien.Views.Reader"
        mc:Ignorable="d"
        Title="Quản lý thư viện" Height="760" Width="1220"
        WindowStartupLocation="CenterScreen"
        Background="#EDF2F8"
        FontFamily="Bahnschrift"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}" Closing="Window_Closing"
        >

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="14" Padding="22" Margin="0,0,0,16" BorderBrush="#D5DFEA" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B2545" Offset="0" />
                    <GradientStop Color="#1E4D8C" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Trang Chủ Thư Viện" FontSize="30" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding Title}" Foreground="#D8E8FF" Margin="0,6,0,0" FontSize="15" />
                </StackPanel>

                <Border Grid.Column="1" Background="#2B5A90" CornerRadius="10" Padding="14,10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Người dùng: " Foreground="#F6FAFF" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtRole" Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Foreground="#F6FAFF" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>


        <!-- Menu theo vai trò được binding từ ViewModel -->
        <ContentControl x:Name="MainContent" Grid.Row="1" Content="{Binding CurrentView}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vmReader:ReaderViewModel}">
                    <viewReader:ReaderView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vmLibrarian:LibrarianViewModel}">
                    <viewLibrarian:LibrarianView/>
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>

    </Grid>
</Window>
