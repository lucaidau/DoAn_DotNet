<UserControl x:Class="DA_QuanLiThuVien.Views.Librarian.Features.QuanLySachView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DA_QuanLiThuVien.Views.Librarian.Features"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Quản lý danh mục sách, cập nhật tồn kho" Foreground="#6B7A90" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Thêm Sách" Margin="0,0,8,0" Padding="12,6" Background="#0B2545" Foreground="White" BorderThickness="0" />
                <Button Content="Sửa" Margin="0,0,8,0" Padding="12,6" Background="#E8F1FF" Foreground="#0B2545" BorderThickness="0" />
                <Button Content="Xóa" Padding="12,6" Background="#FFE8E8" Foreground="#9A2A2A" BorderThickness="0" />
            </StackPanel>
        </Grid>

        <!-- Search + quick stats -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Tìm kiếm" FontWeight="SemiBold" Foreground="#0B2545" />
                    <TextBox Margin="0,8,0,0" Height="30" Text="Từ khóa (tên sách, tác giả...)" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Tổng đầu sách" Foreground="#6B7A90" />
                    <TextBlock Text="1,240" FontSize="22" FontWeight="Bold" Foreground="#0B2545" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="Đang cho mượn" Foreground="#6B7A90" />
                    <TextBlock Text="312" FontSize="22" FontWeight="Bold" Foreground="#0B2545" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Table placeholder -->
        <Border Grid.Row="2" BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Danh sách sách" FontWeight="SemiBold" Foreground="#0B2545" />
                <Border Grid.Row="1" Background="#F8FAFD" CornerRadius="8" Margin="0,12,0,0" Padding="16">
                    <TextBlock Text="Bảng dữ liệu sách sẽ hiển thị tại đây" Foreground="#6B7A90" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
