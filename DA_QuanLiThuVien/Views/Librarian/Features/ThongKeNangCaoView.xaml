<UserControl x:Class="DA_QuanLiThuVien.Views.Librarian.Features.ThongKeNangCaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DA_QuanLiThuVien.Views.Librarian.Features"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Top sách, top độc giả, xu hướng theo thời gian" Margin="0,0,0,16" Foreground="#6B7A90" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Top sách mượn nhiều" FontWeight="SemiBold" Foreground="#0B2545" />
                    <Border Background="#F8FAFD" CornerRadius="8" Margin="0,12,0,0" Padding="16">
                        <TextBlock Text="Danh sách top sách" Foreground="#6B7A90" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="10" Padding="12">
                <StackPanel>
                    <TextBlock Text="Top độc giả" FontWeight="SemiBold" Foreground="#0B2545" />
                    <Border Background="#F8FAFD" CornerRadius="8" Margin="0,12,0,0" Padding="16">
                        <TextBlock Text="Danh sách top độc giả" Foreground="#6B7A90" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
