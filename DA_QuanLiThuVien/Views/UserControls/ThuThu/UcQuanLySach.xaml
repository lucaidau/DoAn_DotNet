<UserControl x:Class="DA_QuanLiThuVien.Views.UserControls.ThuThu.UcQuanLySach"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DA_QuanLiThuVien.Views.UserControls.ThuThu"
             mc:Ignorable="d" 
             d:Tag="quản lí bán sách"
             d:DesignHeight="760" d:DesignWidth="1220">
    <Grid>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F4F8FD" BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox x:Name="txtTieuDeSach" Height="36" Padding="10,8" VerticalContentAlignment="Center" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tiêu đề sách" />
                        <TextBlock Text="Tiêu đề sách" Foreground="#A0AEC0" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtTieuDeSach}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Column="1" Margin="0,0,10,0">
                        <TextBox x:Name="txtTacGia" Height="36" Padding="10,8" VerticalContentAlignment="Center" Text="{Binding NewAuthor, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tác giả" />
                        <TextBlock Text="Tác giả" Foreground="#A0AEC0" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtTacGia}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Column="2" Margin="0,0,10,0">
                        <TextBox x:Name="txtTheLoai" Height="36" Padding="10,8" VerticalContentAlignment="Center" Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}" ToolTip="Thể loại" />
                        <TextBlock Text="Thể loại" Foreground="#A0AEC0" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtTheLoai}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Column="3" Margin="0,0,10,0">
                        <TextBox x:Name="txtTimKiem" Height="36" Padding="10,8" VerticalContentAlignment="Center" ToolTip="Tìm theo tên sách / mã ISBN" />
                        <TextBlock Text="Tìm theo tên sách / mã ISBN" Foreground="#A0AEC0" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtTimKiem}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="4" Width="110" Height="36" Content="Thêm sách" Background="#134074" Foreground="White" FontWeight="Bold" BorderThickness="0" Command="{Binding AddBookCommand}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="DgSach" Grid.Row="0"
                   AutoGenerateColumns="False"
                   SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                   CanUserAddRows="False"
                   IsReadOnly="True"
                   GridLinesVisibility="Horizontal"
                   HeadersVisibility="Column"
                   RowHeaderWidth="0"
                   Background="#FCFDFF"
                   BorderThickness="0"
                   Margin="0,0,0,10">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#E8F0FA" />
                            <Setter Property="Foreground" Value="#0B2545" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Height" Value="38" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="2.5*" />
                        <DataGridTextColumn Header="Tác giả" Binding="{Binding Author}" Width="1.5*" />
                        <DataGridTextColumn Header="Thể loại" Binding="{Binding Category}" Width="1.5*" />
                        <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="1.5*" />
                        <DataGridTextColumn Header="Năm XB" Binding="{Binding PublishYear}" Width="*" />
                        <DataGridCheckBoxColumn Header="Còn sách" Binding="{Binding IsAvailable, Mode=OneWay}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Sửa" Width="90" Height="34" Margin="0,0,8,0" Background="#1E4D8C" Foreground="White" BorderThickness="0" />
                    <Button Content="Làm mới" Width="100" Height="34" Margin="0,0,8,0" Background="#5E728B" Foreground="White" BorderThickness="0" />
                    <Button Content="Xóa sách đã chọn" Width="140" Height="34" Background="#B42318" Foreground="White" FontWeight="Bold" BorderThickness="0" Command="{Binding RemoveBookCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
