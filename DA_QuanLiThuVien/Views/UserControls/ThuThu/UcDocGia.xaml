<UserControl x:Class="DA_QuanLiThuVien.Views.UserControls.ThuThu.UcDocGia"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DA_QuanLiThuVien.Views.UserControls.ThuThu"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#F4F8FD" BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <TextBox x:Name="txtMaPhieu" Height="36" Padding="10,8" VerticalContentAlignment="Center" ToolTip="Mã phiếu"/>
                    <TextBlock Text="Mã phiếu" Foreground="#A0AEC0" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtMaPhieu}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Grid.Column="1" Margin="0,0,10,0">
                    <TextBox x:Name="txtHoTen" Height="36" Padding="10,8" VerticalContentAlignment="Center" ToolTip="Họ tên"/>
                    <TextBlock Text="Họ tên" Foreground="#A0AEC0" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtHoTen}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Grid.Column="2" Margin="0,0,10,0">
                    <TextBox x:Name="txtSDT" Height="36" Padding="10,8" VerticalContentAlignment="Center" ToolTip="Số điện thoại"/>
                    <TextBlock Text="Số điện thoại" Foreground="#A0AEC0" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSDT}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Grid.Column="3" Margin="0,0,10,0">
                    <TextBox x:Name="txtEmail" Height="36" Padding="10,8" VerticalContentAlignment="Center" ToolTip="Email"/>
                    <TextBlock Text="Email" Foreground="#A0AEC0" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtEmail}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="4" Height="36" Content="Thêm độc giả" Click="btnThem_Click" Background="#134074" Foreground="White" BorderThickness="0" FontWeight="Bold" />
            </Grid>
        </Border>

        <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0" Background="#FCFDFF" BorderThickness="0" ItemsSource="{Binding Readers}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã ĐG" Binding="{Binding ReaderId}" Width="*" />
                <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="2*" />
                <DataGridTextColumn Header="Số điện thoại" Binding="{Binding Phone}" Width="1.5*" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" Width="2*" />
                <DataGridTextColumn Header="Ngày hết hạn thẻ" Binding="{Binding CardExpiryDate, StringFormat=dd/MM/yyyy}" Width="1.5*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Sửa" Click="btnSua_Click" Width="90" Height="34" Margin="0,0,8,0" Background="#1E4D8C" Foreground="White" BorderThickness="0" />
            <Button Content="Khóa thẻ" Click="btnKhoaThe_Click" Width="100" Height="34" Margin="0,0,8,0" Background="#5E728B" Foreground="White" BorderThickness="0" />
            <Button Content="Xóa" Click="btnXoa_Click" Width="90" Height="34" Background="#B42318" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</UserControl>
