<UserControl x:Class="DA_QuanLiThuVien.Views.UserControls.ThuThu.UcBaoCao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DA_QuanLiThuVien.Views.UserControls.ThuThu"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DatePicker Grid.Column="0" Height="34" Margin="0,0,10,0" SelectedDate="{Binding ReportFromDate, Mode=OneWay}" HorizontalAlignment="Stretch" />
            <DatePicker Grid.Column="1" Height="34" Margin="0,0,10,0" SelectedDate="{Binding ReportToDate, Mode=OneWay}" HorizontalAlignment="Stretch" />
            <ComboBox Grid.Column="2" Height="34" Margin="0,0,10,0" ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReportType, Mode=OneWay}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="3" Content="Xem báo cáo" Width="110" Height="34" Background="#134074" Foreground="White" BorderThickness="0" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F7FAFF" BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Biểu đồ thống kê" FontWeight="Bold" FontSize="16" Foreground="#0B2545" />
                    <Border Height="250" Margin="0,12,0,0" Background="White" BorderBrush="#D8E0EB" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Số lượt mượn sách theo tháng" Foreground="#5D718E" FontSize="13" />
                            <ItemsControl ItemsSource="{Binding BorrowChartData}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="#0B2545" FontWeight="SemiBold" />
                                            <Border Grid.Column="1" Height="18" Background="#E8EEF7" CornerRadius="4" VerticalAlignment="Center">
                                                <Border Width="{Binding BarWidth}" Height="18" Background="#1E4D8C" CornerRadius="4" HorizontalAlignment="Left" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#24364D" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#F7FAFF" BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="Tổng hợp nhanh" FontWeight="Bold" FontSize="16" Foreground="#0B2545" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ReportItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="#24364D" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#0B2545" FontWeight="SemiBold" Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
