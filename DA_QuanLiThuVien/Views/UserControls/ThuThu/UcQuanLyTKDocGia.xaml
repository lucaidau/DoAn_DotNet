<UserControl x:Class="DA_QuanLiThuVien.Views.UserControls.ThuThu.UcQuanLyTKDocGia"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DA_QuanLiThuVien.Views.UserControls.ThuThu"
             mc:Ignorable="d"
             d:DesignHeight="580" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- Style cho nút chức năng -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho DataGrid Header -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F5FC"/>
            <Setter Property="Foreground" Value="#324967"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D5DFEA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- Style cho DataGridRow -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2A3A"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBF3FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E8FF"/>
                    <Setter Property="Foreground" Value="#0B2545"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style chung TextBox -->
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#C8D8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1E4D8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho ComboBox -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#C8D8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <!-- Thanh tìm kiếm / lọc -->
            <RowDefinition Height="Auto"/>
            <!-- Bảng danh sách -->
            <RowDefinition Height="*"/>
            <!-- Form nhập liệu + nút hành động -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===== ROW 0: THANH TÌM KIẾM / LỌC ===== -->
        <Border Grid.Row="0" Background="#F4F8FD" BorderBrush="#D5DFEA"
                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tìm theo tên / SĐT / email -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <TextBox x:Name="txtTimKiem" Style="{StaticResource InputBoxStyle}"
                             ToolTip="Tìm theo tên, SĐT hoặc email"/>
                    <TextBlock Text="🔍  Tìm theo tên, SĐT, email..."
                               Foreground="#A0AEC0" Margin="12,0,0,0"
                               IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtTimKiem}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Lọc trạng thái -->
                <ComboBox Grid.Column="1" x:Name="cboTrangThai"
                          Style="{StaticResource ComboBoxStyle}" Margin="0,0,10,0"
                          SelectedIndex="0">
                    <ComboBoxItem Content="-- Tất cả trạng thái --"/>
                    <ComboBoxItem Content="Đang hoạt động"/>
                    <ComboBoxItem Content="Bị khóa"/>
                </ComboBox>

                <!-- Lọc giới tính -->
                <ComboBox Grid.Column="2" x:Name="cboGioiTinh"
                          Style="{StaticResource ComboBoxStyle}" Margin="0,0,10,0"
                          SelectedIndex="0">
                    <ComboBoxItem Content="-- Tất cả giới tính --"/>
                    <ComboBoxItem Content="Nam"/>
                    <ComboBoxItem Content="Nữ"/>
                </ComboBox>

                <!-- Nút Tìm kiếm -->
                <Button Grid.Column="3" x:Name="btnTimKiem"
                        Content="Tìm kiếm"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#1E4D8C" Foreground="White"
                        Margin="0,0,8,0" Click="btnTimKiem_Click"/>

                <!-- Nút Làm mới -->
                <Button Grid.Column="4" x:Name="btnLamMoi"
                        Content="↺  Làm mới"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#EDF2F8" Foreground="#324967"
                        Click="btnLamMoi_Click"/>
            </Grid>
        </Border>

        <!-- ===== ROW 1: BẢNG DANH SÁCH ===== -->
        <Border Grid.Row="1" BorderBrush="#D5DFEA" BorderThickness="1"
                CornerRadius="8" Margin="0,0,0,10" ClipToBounds="True">
            <DataGrid x:Name="dgTaiKhoan"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      Background="White"
                      BorderThickness="0"
                      AlternatingRowBackground="#F8FAFD"
                      RowHeight="42"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="dgTaiKhoan_SelectionChanged">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT"       Width="55"   Binding="{Binding STT}"/>
                    <DataGridTextColumn Header="Tên TK"    Width="1.2*" Binding="{Binding TenTK}"/>
                    <DataGridTextColumn Header="Họ và tên" Width="2*"   Binding="{Binding HoTen}"/>
                    <DataGridTextColumn Header="SĐT"       Width="1.2*" Binding="{Binding SDT}"/>
                    <DataGridTextColumn Header="Email"     Width="2*"   Binding="{Binding Email}"/>
                    <DataGridTextColumn Header="Giới tính" Width="0.9*" Binding="{Binding GioiTinhText}"/>
                    <DataGridTemplateColumn Header="Trạng thái" Width="1.1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Center"
                                        Background="{Binding TrangThaiBg}">
                                    <TextBlock Text="{Binding TrangThaiText}"
                                               Foreground="{Binding TrangThaiFg}"
                                               FontWeight="SemiBold" FontSize="11"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Tiền đặt cọc" Width="1.2*" Binding="{Binding SoTienDatCoc, StringFormat={}{0:N0} đ}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ===== ROW 2: FORM NHẬP + NÚT HÀNH ĐỘNG ===== -->
        <Border Grid.Row="2" Background="#F4F8FD" BorderBrush="#D5DFEA"
                BorderThickness="1" CornerRadius="8" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Dòng 1: Các trường thông tin -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.85*"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tên tài khoản -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Tên tài khoản" FontSize="11" Foreground="#5A6D86"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtTenTK" Style="{StaticResource InputBoxStyle}"/>
                    </StackPanel>

                    <!-- Họ tên -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Họ và tên" FontSize="11" Foreground="#5A6D86"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtHoTen" Style="{StaticResource InputBoxStyle}"/>
                    </StackPanel>

                    <!-- Số điện thoại -->
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Số điện thoại" FontSize="11" Foreground="#5A6D86"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSDT" Style="{StaticResource InputBoxStyle}"/>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Email" FontSize="11" Foreground="#5A6D86"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtEmail" Style="{StaticResource InputBoxStyle}"/>
                    </StackPanel>

                    <!-- Giới tính -->
                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Text="Giới tính" FontSize="11" Foreground="#5A6D86"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboGioiTinhForm" Style="{StaticResource ComboBoxStyle}"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Nam"/>
                            <ComboBoxItem Content="Nữ"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Mật khẩu mới -->
                    <StackPanel Grid.Column="5">
                        <TextBlock Text="Mật khẩu mới" FontSize="11" Foreground="#5A6D86"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="txtMatKhau" Height="36" Padding="10,8"
                                     VerticalContentAlignment="Center" FontSize="13"
                                     BorderBrush="#C8D8E8" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <!-- Dòng 2: Nút hành động -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnThem" Content="＋  Thêm mới"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#134074" Foreground="White"
                            Margin="0,0,8,0" Width="120"
                            Click="btnThem_Click"/>
                    <Button x:Name="btnSua" Content="✏  Cập nhật"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#1E4D8C" Foreground="White"
                            Margin="0,0,8,0" Width="120"
                            Click="btnSua_Click"/>
                    <Button x:Name="btnKhoa" Content="🔒  Khóa TK"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#5E728B" Foreground="White"
                            Margin="0,0,8,0" Width="120"
                            Click="btnKhoa_Click"/>
                    <Button x:Name="btnMoKhoa" Content="🔓  Mở khóa"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#0B6E4F" Foreground="White"
                            Margin="0,0,8,0" Width="120"
                            Click="btnMoKhoa_Click"/>
                    <Button x:Name="btnXoa" Content="🗑  Xóa"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#B42318" Foreground="White"
                            Width="100"
                            Click="btnXoa_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
