<UserControl x:Class="DA_QuanLiThuVien.Views.UserControls.ThuThu.UcMuonTra"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DA_QuanLiThuVien.Views.UserControls.ThuThu"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.8*" />
                <ColumnDefinition Width="1.8*" />
                <ColumnDefinition Width="1.8*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,10,0">
                <TextBox x:Name="txtMaPhieuMuon" Height="36" Padding="10,8" VerticalContentAlignment="Center" ToolTip="Mã phiếu" />
                <TextBlock Text="Mã phiếu" Foreground="#A0AEC0" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtMaPhieuMuon}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Grid Grid.Column="1" Margin="0,0,10,0">
                <TextBox x:Name="txtMaDocGia" Height="36" Padding="10,8" VerticalContentAlignment="Center" ToolTip="Mã độc giả" />
                <TextBlock Text="Mã độc giả" Foreground="#A0AEC0" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtMaDocGia}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Grid Grid.Column="2" Margin="0,0,10,0">
                <TextBox x:Name="txtMaSach" Height="36" Padding="10,8" VerticalContentAlignment="Center" ToolTip="Mã sách" />
                <TextBlock Text="Mã sách" Foreground="#A0AEC0" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtMaSach}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <DatePicker Grid.Column="3" Height="36" Margin="0,0,10,0" />
            <Button Grid.Column="4" Width="130" Height="36" Content="Tạo phiếu mượn" Background="#0B6E4F" Foreground="White" BorderThickness="0" FontWeight="Bold" />
        </Grid>

        <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0" Background="#FCFDFF" BorderThickness="0" ItemsSource="{Binding LoanRecords}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã phiếu" Binding="{Binding LoanId}" Width="*" />
                <DataGridTextColumn Header="Độc giả" Binding="{Binding ReaderName}" Width="1.8*" />
                <DataGridTextColumn Header="Sách" Binding="{Binding BookTitle}" Width="2.2*" />
                <DataGridTextColumn Header="Ngày mượn" Binding="{Binding LoanDate, StringFormat=dd/MM/yyyy}" Width="1.2*" />
                <DataGridTextColumn Header="Hạn trả" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="1.2*" />
                <DataGridTextColumn Header="Ngày trả" Binding="{Binding ReturnDate, StringFormat=dd/MM/yyyy}" Width="1.2*" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="1.2*" />
                <DataGridTextColumn Header="Tiền phạt" Binding="{Binding FineAmount, StringFormat=N0}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Trả sách" Width="100" Height="34" Margin="0,0,8,0" Background="#0B6E4F" Foreground="White" BorderThickness="0" />
            <Button Content="Gia hạn" Width="100" Height="34" Margin="0,0,8,0" Background="#1E4D8C" Foreground="White" BorderThickness="0" />
            <Button Content="Đánh dấu mất" Width="110" Height="34" Background="#B42318" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</UserControl>
