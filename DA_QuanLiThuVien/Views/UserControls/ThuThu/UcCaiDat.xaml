<UserControl x:Class="DA_QuanLiThuVien.Views.UserControls.ThuThu.UcCaiDat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DA_QuanLiThuVien.Views.UserControls.ThuThu"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F7FAFF" BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="Thông số thư viện" FontSize="16" FontWeight="Bold" Foreground="#0B2545" />
                <TextBlock Text="Tên thư viện" Margin="0,12,0,4" />
                <TextBox Height="34" Padding="10,8" Text="Thư viện Trường THPT" />
                <TextBlock Text="Số ngày mượn tối đa" Margin="0,10,0,4" />
                <TextBox Height="34" Padding="10,8" Text="14" />
                <TextBlock Text="Mức phạt/ngày" Margin="0,10,0,4" />
                <TextBox Height="34" Padding="10,8" Text="5000" />
                <Button Content="Lưu cấu hình" Width="110" Height="34" Margin="0,14,0,0" Background="#134074" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#F7FAFF" BorderBrush="#D5DFEA" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel>
                <TextBlock Text="Tài khoản và bảo mật" FontSize="16" FontWeight="Bold" Foreground="#0B2545" />
                <CheckBox Content="Bật xác thực 2 bước" Margin="0,12,0,0" />
                <CheckBox Content="Yêu cầu đổi mật khẩu mới 90 ngày" Margin="0,8,0,0" />
                <CheckBox Content="Ghi log hoạt động hệ thống" Margin="0,8,0,0" IsChecked="True" />

                <TextBlock Text="Sao lưu dữ liệu" Margin="0,14,0,4" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Backup ngay" Width="100" Height="34" Margin="0,0,8,0" Background="#0B6E4F" Foreground="White" BorderThickness="0" />
                    <Button Content="Khôi phục" Width="100" Height="34" Background="#5E728B" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
